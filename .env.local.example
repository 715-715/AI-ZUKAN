# Supabaseプロジェクトの「Settings > API」から取得してコピーしてください
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# CCBill Webhookからサブスク状態をDBに直接反映させるために使用
# 絶対に NEXT_PUBLIC_ を付けないこと（ブラウザに漏れるとRLSを迂回されてしまいます）
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- CCBill（審査通過後、管理画面から取得） ---
CCBILL_CLIENT_ACCNUM=999999
CCBILL_CLIENT_SUBACC=0000
CCBILL_FLEXFORM_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
CCBILL_SALT=your-encryption-key-salt

# 価格設定（Dynamic Pricing）。まずは初期費用=継続費用の単純な月額プランを想定
CCBILL_INITIAL_PRICE=10.00
CCBILL_INITIAL_PERIOD=30
CCBILL_RECURRING_PRICE=10.00
CCBILL_RECURRING_PERIOD=30
CCBILL_NUM_REBILLS=99
CCBILL_CURRENCY_CODE=392

# 自サイトのURL（決済完了/失敗後にCCBillから戻ってくる先の生成に使用）
NEXT_PUBLIC_SITE_URL=https://your-domain.example.com
